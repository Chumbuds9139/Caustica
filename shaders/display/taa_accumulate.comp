#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba16f) uniform readonly  image2D current; // this frame's image (NRD-combined or raw trace)
layout(binding = 1, set = 0, rgba16f) uniform readonly  image2D history; // previous accumulation
layout(binding = 2, set = 0, rgba16f) uniform writeonly image2D outAcc;  // new accumulation (alpha = frame count)
layout(binding = 3, set = 0, rg16f)   uniform readonly  image2D motion;  // render-pixel MVs (prev - current)
layout(binding = 4, set = 0, r32f)    uniform readonly  image2D viewZ;   // linear view depth

layout(push_constant) uniform Push {
    int width;
    int height;
    float mvScaleX;   // 1 / renderWidth  (pixel MVs -> uv)
    float mvScaleY;   // 1 / renderHeight
    int reset;        // 1 = discard history everywhere (FOV change, rebase jump, toggle)
    float maxFrames;  // accumulation window cap
} pc;

// Matches the viewZ cap the tracer writes for sky/miss pixels (and RtComposite's
// NRD_DENOISING_RANGE): anything beyond is sky and accumulates in place only.
const float DENOISING_RANGE = 500000.0;

vec3 loadSanitized(ivec2 p) {
    ivec2 q = clamp(p, ivec2(0), ivec2(pc.width - 1, pc.height - 1));
    return clamp(imageLoad(current, q).rgb, vec3(0.0), vec3(65504.0));
}

// YCoCg gives the history clamp a luminance-aligned box: RGB min/max boxes are enormous on
// saturated colors, which let ghost history survive at block edges (the camera-turn smear) and
// clamped it inconsistently frame to frame on bright/dark pixels (the flicker).
vec3 toYCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 fromYCoCg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= pc.width || pix.y >= pc.height) {
        return;
    }
    vec3 cur = loadSanitized(pix);
    vec3 curY = toYCoCg(cur);

    if (pc.reset != 0) {
        imageStore(outAcc, pix, vec4(cur, 1.0));
        return;
    }

    // Reproject with the renderer's jitter-free motion vectors (the same vectors FSR already
    // reprojects with successfully): mv = previous - current, in render pixels -> uv.
    vec2 mv = imageLoad(motion, pix).rg * vec2(pc.mvScaleX, pc.mvScaleY);
    float z = imageLoad(viewZ, pix).r;
    bool sky = !(z < DENOISING_RANGE);
    // Sky has no meaningful history (infinite depth): accumulate it in place (it is static per
    // camera view; camera motion shakes it off via the motion-adaptive weight below).
    vec2 histUv = sky ? (vec2(pix) + 0.5) / vec2(pc.width, pc.height)
                      : (vec2(pix) + 0.5) / vec2(pc.width, pc.height) + mv;

    ivec2 hp = clamp(ivec2(floor(histUv * vec2(pc.width, pc.height))),
                     ivec2(0), ivec2(pc.width - 1, pc.height - 1));
    vec4 histSample = imageLoad(history, hp);
    vec3 hist = clamp(histSample.rgb, vec3(0.0), vec3(65504.0));
    float nPrev = clamp(histSample.a, 0.0, pc.maxFrames);

    // Variance clip (Karras & Mora 2021) in YCoCg: the 3x3 neighbourhood's mean +/- 1.25 sigma
    // bounds what the reprojection may contribute. Tighter than min/max on real content, and the
    // clip toward the current sample keeps legitimate history while cutting disocclusion ghosts.
    vec3 sum = vec3(0.0);
    vec3 sumSq = vec3(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec3 v = toYCoCg(loadSanitized(pix + ivec2(dx, dy)));
            sum += v;
            sumSq += v * v;
        }
    }
    vec3 mu = sum / 9.0;
    vec3 sigma = sqrt(max(sumSq / 9.0 - mu * mu, vec3(0.0)));
    vec3 histY = toYCoCg(hist);
    vec3 histClipped = clamp(histY, mu - 1.25 * sigma, mu + 1.25 * sigma);

    // Motion-adaptive blend: while the camera moves, shrink the effective window proportionally to
    // the motion magnitude so reprojected history cannot trail behind moving edges (the old
    // fixed 1/n blend smeared blocks the whole time the camera turned). Static scenes keep the
    // full 1/n window. No hard per-pixel restart: sudden history loss was a flicker source.
    float mvPixels = length(mv * vec2(pc.width, pc.height));
    // Luminance-adaptive window: dark regions (a torchlit cave's indirect light after a camera
    // turn) converge from disocclusion with HALF the window, so the light "births" ~2x faster —
    // the residual noise is invisible in the dark anyway; bright regions keep the full window for
    // a calm steady state. As the pixel brightens the window grows back automatically.
    float luma = dot(cur, vec3(0.2126, 0.7152, 0.0722));
    float localMaxFrames = mix(pc.maxFrames * 0.5, pc.maxFrames, clamp(luma * 20.0, 0.0, 1.0));
    float n = min(nPrev + 1.0, localMaxFrames);
    float alpha = max(1.0 / n, clamp(mvPixels * 0.2, 0.0, 0.7));

    vec3 acc = fromYCoCg(mix(histClipped, curY, alpha));
    imageStore(outAcc, pix, vec4(max(acc, vec3(0.0)), n));
}
