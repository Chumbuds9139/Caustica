#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba16f) uniform readonly  image2D current; // this pass's noisy input
layout(binding = 1, set = 0, rgba16f) uniform writeonly image2D outImg;  // filtered output
layout(binding = 2, set = 0, r32f)    uniform readonly  image2D depth;   // reversed-Z NDC depth (the trace guide)
layout(binding = 3, set = 0, rgba16f) uniform readonly  image2D normal;  // world normal (xyz) + roughness (w)

layout(push_constant) uniform Push {
    int width;
    int height;
    int step;    // à-trous tap spacing (1, 2, ...): the wavelet doubles its reach per pass
    int extraSkySmooth; // 1 = frame generation is presenting frames this frame (see sigmaL below)
} pc;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
const float KERNEL[5] = float[5](1.0, 4.0, 6.0, 4.0, 1.0); // binomial, /256 over the 5x5

vec3 loadSanitized(ivec2 p) {
    ivec2 q = clamp(p, ivec2(0), ivec2(pc.width - 1, pc.height - 1));
    return clamp(imageLoad(current, q).rgb, vec3(0.0), vec3(65504.0));
}

// Edge-avoiding à-trous wavelet pass over the raw trace: the single-frame noise killer with NO
// history, so it cannot ghost on camera motion (the failure mode that retired the NRD/REBLUR
// stack). Runs before temporal accumulation / upscaling; two passes (step 1, 2) give a reach of
// ~5px at render res. Weights: binomial kernel x luminance similarity x depth proximity x normal
// alignment. A firefly guard scales lone bright samples down toward the center luminance before
// blending so one hot Monte-Carlo sample cannot bleed a star into its neighbourhood.
//
// SKY RULES (the black-sky fix): miss pixels carry reversed-Z depth ~0 and/or a degenerate
// normal, which used to collapse every weight — including the center tap — to ~0 and divide by
// nothing (black sky). Sky/miss pixels now skip the geometry edge-stops and the firefly guard
// entirely (the sun and bright clouds are legitimately small, intense features — the guard was
// eating them), and sky taps never blend with geometry taps (and vice-versa) so horizons stay
// crisp.
bool isSkyPixel(float z, vec3 n) {
    return z < 0.001 || dot(n, n) < 0.25;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= pc.width || pix.y >= pc.height) {
        return;
    }
    vec4 ccFull = imageLoad(current, pix);
    vec3 cc = clamp(ccFull.rgb, vec3(0.0), vec3(65504.0));
    float lc = dot(cc, LUMA);
    float zc = imageLoad(depth, pix).r;
    vec3 nc = imageLoad(normal, pix).rgb;
    bool centerSky = isSkyPixel(zc, nc);

    // HDR-adaptive: bright regions tolerate brighter taps. When frame generation is presenting,
    // the sky additionally smooths harder: FG interpolates between presented frames, and any
    // per-frame residual sky noise (1-SPP grain the temporal stage hasn't converged yet, worst
    // while the camera moves) gets amplified into visible sky flicker by the interpolation. The
    // extra blur is free in a region with no fine geometry detail; the sun/moon keep their edge
    // through the luminance weight (sky-vs-disc contrast is high). Off when FG isn't presenting,
    // so the plain path keeps maximum sky crispness.
    float sigmaL = (centerSky && pc.extraSkySmooth != 0)
            ? (0.15 + 0.5 * lc)
            : (0.08 + 0.35 * lc);
    float wsum = 0.0;
    vec3 csum = vec3(0.0);
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 q = pix + ivec2(dx, dy) * pc.step;
            ivec2 qc = clamp(q, ivec2(0), ivec2(pc.width - 1, pc.height - 1));
            vec3 ct = loadSanitized(q);
            float lt = dot(ct, LUMA);
            float zt = imageLoad(depth, qc).r;
            vec3 nt = imageLoad(normal, qc).rgb;
            // Never blur sky into geometry or geometry into sky.
            if (isSkyPixel(zt, nt) != centerSky) {
                continue;
            }
            if (!centerSky) {
                // Firefly guard (geometry only): cap a tap's contribution at ~4x the center luminance.
                ct *= min(1.0, (4.0 * lc + 0.2) / max(lt, 1.0e-4));
                lt = dot(ct, LUMA);
            }
            float wl = exp(-abs(lt - lc) / sigmaL);
            float wd = 1.0;
            float wn = 1.0;
            if (!centerSky) {
                float dd = abs(zt - zc) / max(zc, 0.02); // reversed-Z: relative difference, guarded near far
                wd = exp(-dd * dd * 24.0);
                float dn = 1.0 - clamp(dot(nt, nc), 0.0, 1.0);
                wn = exp(-dn * dn * 64.0);
            }
            float w = KERNEL[dy + 2] * KERNEL[dx + 2] * wl * wd * wn;
            wsum += w;
            csum += w * ct;
        }
    }
    // Degenerate weight sum (shouldn't happen anymore, but never divide into garbage): pass through.
    if (wsum < 1.0e-3) {
        imageStore(outImg, pix, ccFull);
        return;
    }
    imageStore(outImg, pix, vec4(csum / wsum, ccFull.a));
}
